{
  "name": "@creative-introvert/tons-of-tests-cli",
  "version": "3.0.0-rc.2",
  "type": "module",
  "license": "MIT",
  "sideEffects": [],
  "tags": [
    "typescript",
    "performance",
    "confusion-matrix",
    "test",
    "test-runner",
    "coverage"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/creative-introvert/tons-of-tests.git"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist",
    "provenance": true
  },
  "scripts": {
    "build": "babel build/esm --out-dir build/cjs --env-name cjs && babel build/esm --out-dir build/esm --env-name esm && tsx src/pack.ts",
    "postversion": "tsx src/replace-version.ts"
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-export-namespace-from": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "babel-plugin-annotate-pure-calls": "0.5.0",
    "type-fest": "5.10.0"
  },
  "dependencies": {
    "@creative-introvert/tons-of-tests": "workspace:*",
    "@effect/platform-node": "4.0.6",
    "ansi-colors": "4.1.3",
    "effect": "4.0.6"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  }
}
