{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "build/esm",
    "declarationDir": "build/dts",
    "tsBuildInfoFile": ".tsbuildinfo/build.tsbuildinfo",
    "stripInternal": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/pack.ts", "src/replace-version.ts"],
  "references": [
    {
      "path": "../tons-of-tests"
    }
  ]
}
