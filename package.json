{
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "check": "oxlint --type-aware --deny-warnings && oxfmt --check",
    "build": "pnpm --filter \"@creative-introvert/tons-of-tests*\" exec rm -rf build dist .tsbuildinfo && tsc --build && pnpm --filter \"@creative-introvert/tons-of-tests*\" run build",
    "test": "vitest run",
    "changesets-version": "changeset version && pnpm -r --if-present run postversion",
    "changesets-publish": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@effect/tsgo": "0.57.0",
    "@effect/vitest": "4.0.6",
    "@types/node": "24.19.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
